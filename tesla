#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["dateparser>=1.2"]
# ///
"""Transforma uma frase falada numa ação de tarefa e entrega a um destino.

Recebe o texto por --texto ou pelo stdin (o voxtype manda a transcrição pelo stdin).

  Adicionar: "<nome> [prioridade X] [começo <data>] [fim <data>] [na coluna <coluna>]"
  Mover:     "mover <uid> para <coluna>"

Com --parser llm a frase pode ser livre ("tenho que entregar a lista de segurança até
sexta, é urgente: resolver as questões e revisar"), e o LLM preenche também etiquetas,
descrição, checklist e tamanho. Campo não falado fica em branco. O destino (configurado em ~/.config/tesla/config.toml)
é um executável que segue o PROTOCOLO.md.
"""

from __future__ import annotations

import argparse
import datetime as dt
import difflib
import json
import os
import re
import shlex
import subprocess
import sys
import tomllib
import unicodedata
import urllib.request
from dataclasses import dataclass, field
from pathlib import Path
from typing import Protocol

import dateparser

VERSAO_PROTOCOLO = 1
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "tesla/config.toml"

# Prioridade falada -> PRIORITY do VTODO (RFC 5545: 1 = mais alta, 9 = mais baixa).
PRIORIDADES = {"maxima": 1, "alta": 3, "media": 5, "baixa": 7, "minima": 9}
SINONIMOS_PRIORIDADE = {"urgente": "maxima", "altissima": "maxima", "normal": "media", "baixissima": "minima"}


def chave(s: str) -> str:
    """Minúsculo e sem acento. Preserva o comprimento de texto NFC em português."""
    return "".join(c for c in unicodedata.normalize("NFD", s.lower()) if unicodedata.category(c) != "Mn")


# ---------------------------------------------------------------- configuração

@dataclass
class Config:
    destino: list[str]
    llm_url: str
    llm_modelo: str


def ler_config() -> Config:
    dados = tomllib.loads(CONFIG.read_text(encoding="utf-8")) if CONFIG.exists() else {}
    destino = dados.get("destino")
    if not destino:
        raise SystemExit(f"destino não configurado em {CONFIG} (rode install.sh)")
    if isinstance(destino, str):
        destino = shlex.split(destino)
    llm = dados.get("llm", {})
    return Config(
        destino=[os.path.expanduser(p) for p in destino],
        llm_url=os.environ.get("TESLA_OLLAMA", llm.get("url", "http://localhost:11434")),
        llm_modelo=os.environ.get("TESLA_OLLAMA_MODELO", llm.get("modelo", "qwen3:8b")),
    )


# ---------------------------------------------------------------- ações

@dataclass
class Adicionar:
    summary: str
    priority: int | None = None
    dtstart: dt.date | None = None
    due: dt.date | None = None
    coluna: str | None = None
    description: str | None = None
    categories: list[str] = field(default_factory=list)
    checklist: list[str] = field(default_factory=list)
    size: str | None = None
    avisos: list[str] = field(default_factory=list)

    def json(self) -> dict:
        return {"versao": VERSAO_PROTOCOLO, "acao": "adicionar", "summary": self.summary,
                "priority": self.priority,
                "dtstart": self.dtstart.isoformat() if self.dtstart else None,
                "due": self.due.isoformat() if self.due else None,
                "coluna": self.coluna,
                "description": self.description, "categories": self.categories,
                "checklist": self.checklist, "size": self.size}


@dataclass
class Mover:
    uid: str
    coluna: str
    avisos: list[str] = field(default_factory=list)

    def json(self) -> dict:
        return {"versao": VERSAO_PROTOCOLO, "acao": "mover", "uid": self.uid, "coluna": self.coluna}


Acao = Adicionar | Mover


class Parser(Protocol):
    def interpretar(self, texto: str, colunas: list[str], hoje: dt.date) -> Acao: ...


# ---------------------------------------------------------------- campos falados

NUMEROS = {"um": "1", "uma": "1", "dois": "2", "duas": "2", "tres": "3", "quatro": "4", "cinco": "5",
           "seis": "6", "sete": "7", "oito": "8", "nove": "9", "dez": "10"}
# Reescritas para frases que o dateparser não entende em pt.
REESCRITAS = [
    (r"\bdepois de amanha\b", "em 2 dias"),
    (r"\bdaqui a\b", "em"),
    (r"\b(semana|mes|ano) que vem\b", r"em 1 \1"),
    (r"\bproxim[ao] (semana|mes|ano)\b", r"em 1 \1"),
    (r"\bproxim[ao]\s+", ""),
    (r"\s+que vem\b", ""),
    (r"\bdia (\d)", r"\1"),
    (r"-feira\b", ""),
]


def data_falada(texto: str, hoje: dt.date) -> dt.date | None:
    t = chave(texto).strip()
    t = " ".join(NUMEROS.get(p, p) for p in t.split())
    for padrao, troca in REESCRITAS:
        t = re.sub(padrao, troca, t)
    if not t:
        return None
    try:  # o LLM pode já ter devolvido ISO
        return dt.date.fromisoformat(t)
    except ValueError:
        pass
    base = dt.datetime.combine(hoje, dt.time())
    d = dateparser.parse(t, languages=["pt"], settings={
        "PREFER_DATES_FROM": "future", "RELATIVE_BASE": base, "DATE_ORDER": "DMY"})
    if d and re.fullmatch(r"\d{1,2}", t) and d.date() < hoje:
        # "dia 5" já passou neste mês: o dateparser não aplica PREFER_DATES_FROM a um dia solto.
        ano, mes = (hoje.year + 1, 1) if hoje.month == 12 else (hoje.year, hoje.month + 1)
        try:
            return dt.date(ano, mes, int(t))
        except ValueError:
            return None
    return d.date() if d else None


def limpar_nome(nome: str) -> str:
    """Tira o verbo de comando do começo ("anotar, estudar...") e conectivos que sobram no fim
    ("estudar redes de [prioridade alta]")."""
    # "criar" também começa tarefa ("criar backup"): só sai com "tarefa" ou "card" depois.
    nome = re.sub(r"^(?:(?:adicionar|adiciona|adicione|anotar|anota|anote)\b[\s,:]*"
                  r"|(?:nova|novo|criar|cria|crie)\s+(?=(?:a\s+)?(?:tarefa|card)\b))"
                  r"(?:a\s+)?(?:(?:tarefa|card)\b[\s,:]*)?", "", nome.strip(), flags=re.I)
    return re.sub(r"(?:\s+(?:e|com|de|da|do|na|no|em|para|pra))+\s*$", "", nome.strip(), flags=re.I).strip()


def coluna_falada(texto: str, colunas: list[str]) -> str | None:
    alvo = chave(texto).strip()
    alvo = re.sub(r"^(?:a|o|para|pra|pro|na|no|em|coluna)\s+", "", alvo)
    alvo = re.sub(r"^(?:a|o|coluna)\s+", "", alvo)
    por_chave = {chave(c): c for c in colunas}
    achou = difflib.get_close_matches(alvo, por_chave, n=1, cutoff=0.6)
    return por_chave[achou[0]] if achou else None


def prioridade_falada(texto: str) -> int | None:
    for palavra in chave(texto).split():
        palavra = SINONIMOS_PRIORIDADE.get(palavra, palavra)
        if palavra in PRIORIDADES:
            return PRIORIDADES[palavra]
    return None


# ---------------------------------------------------------------- parsers

class DateparserParser:
    """Palavras-chave por regex; trechos de data vão para o dateparser."""

    MOVER = re.compile(r"^(?:mover|mova|move|passar|passa|mude|mudar)\s+(?:a\s+|o\s+)?(?:tarefa\s+|card\s+)?"
                       r"(?:numero\s+)?(\d+)\s+(?:para|pra|pro|em|na|no)\s+(.+)$")
    CAMPOS = {
        "priority": r"prioridade",
        "dtstart": r"(?:data de )?(?:comeco|comeca|comecar|inicio|inicia|iniciar|a partir de)",
        "due": r"(?:data de )?(?:fim|final|prazo|termina|terminar|termino|entrega|vence|vencimento"
               r"|ate(?= (?:o |a )?(?:dia|amanha|depois|hoje|daqui|proxim|segunda|terca|quarta|quinta|sexta|sabado|domingo|\d)))",
        "coluna": r"(?:na|em|para a|pra|para|no) coluna",
    }
    NOMES = {"priority": "prioridade", "dtstart": "começo", "due": "fim", "coluna": "coluna"}

    def interpretar(self, texto: str, colunas: list[str], hoje: dt.date) -> Acao:
        original = re.sub(r"\s+", " ", re.sub(r"[.,;:!?]", " ", unicodedata.normalize("NFC", texto))).strip()
        k = chave(original)

        if m := self.MOVER.match(k):
            coluna = coluna_falada(m.group(2), colunas)
            if not coluna:
                return Mover(m.group(1), "", [f"coluna não encontrada: '{m.group(2)}'"])
            return Mover(m.group(1), coluna)

        achados = []
        for campo, padrao in self.CAMPOS.items():
            if m := re.search(rf"\b{padrao}\b", k):
                achados.append((m.start(), m.end(), campo))
        achados.sort()

        nome = original[: achados[0][0] if achados else len(original)]
        acao = Adicionar(limpar_nome(nome))

        for i, (_, fim, campo) in enumerate(achados):
            limite = achados[i + 1][0] if i + 1 < len(achados) else len(k)
            valor = re.sub(r"\s+(?:e|com|ate)\s*$", "", k[fim:limite].strip())
            if campo == "priority":
                acao.priority = prioridade_falada(valor)
            elif campo == "coluna":
                acao.coluna = coluna_falada(valor, colunas)
            else:
                setattr(acao, campo, data_falada(re.sub(r"^(?:em|no|na|para|pra|e)\s+", "", valor), hoje))
            if getattr(acao, campo) is None:
                acao.avisos.append(f"{self.NOMES[campo]} não entendido: '{valor}'")
        return acao


TAMANHOS = ["XS", "S", "M", "L", "XL"]


class OllamaParser:
    """LLM local com saída em JSON schema. Entende frase livre e preenche todos os campos.

    "mover <uid> para <coluna>" tem forma fixa e fica com a regex do DateparserParser:
    o LLM só extrai os campos de uma tarefa nova. Deixar o LLM escolher a ação fazia
    um modelo de 8B classificar frases comuns como "mover" e inventar um id.

    Datas voltam como foram ditas ("sexta", "dia 25") e passam pelo mesmo data_falada do
    outro parser: o LLM erra conta de calendário. Etiquetas e colunas só valem se existirem
    no destino; o resto é descartado com aviso.
    """

    def __init__(self, url: str, modelo: str, etiquetas: list[str | dict] | None = None):
        self.url, self.modelo = url, modelo
        itens = [e if isinstance(e, dict) else {"nome": e} for e in etiquetas or []]
        self.etiquetas = [e["nome"] for e in itens]
        self.exemplos = {e["nome"]: e.get("exemplos") or [] for e in itens}

    def _schema(self) -> dict:
        texto_ou_nulo = {"type": ["string", "null"]}
        return {
            "type": "object",
            "properties": {
                "nome": texto_ou_nulo,
                "descricao": texto_ou_nulo,
                "prioridade": {"type": ["string", "null"], "enum": [*PRIORIDADES, None]},
                "inicio": texto_ou_nulo,
                "fim": texto_ou_nulo,
                "coluna": texto_ou_nulo,
                "etiquetas": {"type": "array", "items": {"type": "string", "enum": self.etiquetas}}
                if self.etiquetas else {"type": "array", "maxItems": 0},
                "checklist": {"type": "array", "items": {"type": "string"}},
                "tamanho": {"type": ["string", "null"], "enum": [*TAMANHOS, None]},
            },
            "required": ["nome", "descricao", "prioridade", "inicio", "fim", "coluna",
                         "etiquetas", "checklist", "tamanho"],
        }

    def _prompt(self, texto: str, colunas: list[str], hoje: dt.date) -> str:
        dias = ["segunda", "terça", "quarta", "quinta", "sexta", "sábado", "domingo"]
        etiquetas = "".join(
            f"\n  - {nome}" + (f" (tarefas que já usam: {'; '.join(self.exemplos[nome])})" if self.exemplos[nome] else "")
            for nome in self.etiquetas) or " (nenhuma)"
        return (
            f"Hoje é {hoje.isoformat()} ({dias[hoje.weekday()]}).\n"
            f"Colunas do quadro: {', '.join(colunas)}.\nEtiquetas do quadro:{etiquetas}\n"
            "A frase abaixo foi falada e transcrita; descreve UMA tarefa nova. Preencha o JSON:\n"
            "- nome: título curto da tarefa, no infinitivo, sem datas, prioridade, coluna nem detalhes "
            "(ex.: 'entregar lista de segurança').\n"
            "- descricao: os detalhes ditos que não couberam no nome nem nos outros campos (contexto, motivo, "
            "observações), com as palavras da frase. Não acrescente interpretação nem conclusão. null se não houver.\n"
            "- prioridade: maxima se a frase disser urgente, pra hoje ou muito importante; alta se disser "
            "importante; baixa se disser sem pressa, quando der ou se sobrar tempo; minima se disser que tanto faz; "
            "media se disser normal. Se a frase não falar de urgência ou importância, null.\n"
            "- inicio: a expressão de data de quando a tarefa começa ('a partir de segunda', 'começo dia 3'), "
            "copiada como foi dita, sem calcular; null se não houver.\n"
            "- fim: a expressão de data do prazo ou de quando fazer ('até sexta', 'pra amanhã', 'entrega dia 25', "
            "'semana que vem'), copiada como foi dita, sem calcular. Uma data sem palavra de começo vai aqui. "
            "null se não houver.\n"
            "- coluna: uma das colunas do quadro, só se a frase disser o nome dela; null caso contrário.\n"
            "- etiquetas: as etiquetas do quadro do mesmo assunto da frase. Compare com as tarefas que já usam "
            "cada etiqueta. Etiqueta de repetição "
            "(diário, semanal) só se a frase disser que a tarefa se repete. Na dúvida, deixe de fora: lista vazia "
            "é melhor que etiqueta errada. Use só nomes da lista.\n"
            "- checklist: passos ou subtarefas que a frase enumera, cada um curto e no infinitivo; "
            "lista vazia se a frase não enumerar passos. Não invente passos.\n"
            "- tamanho: esforço estimado: XS (minutos), S (até 1 hora), M (algumas horas), L (um dia), "
            "XL (vários dias); null se não der para estimar.\n"
            "Exemplo: 'tenho que entregar a lista da prova 3 de segurança até sexta, é urgente, falta "
            "resolver as questões 4 e 5 e revisar' -> nome 'entregar lista da prova 3 de segurança', "
            "prioridade 'maxima', fim 'até sexta', checklist ['resolver questão 4', 'resolver questão 5', "
            "'revisar'], tamanho 'M', descricao null.\n"
            "Exemplo: 'lembrar de comprar café amanhã' -> nome 'comprar café', prioridade null, fim 'amanhã', "
            "etiquetas [], checklist [], tamanho 'XS', descricao null.\n"
            "Exemplo: 'ver com o professor sobre a bolsa semana que vem, ele pediu o histórico' -> nome "
            "'ver com o professor sobre a bolsa', prioridade null, inicio null, fim 'semana que vem', "
            "descricao 'ele pediu o histórico'.\n"
            f"Frase: {texto}"
        )

    def interpretar(self, texto: str, colunas: list[str], hoje: dt.date) -> Acao:
        regex = DateparserParser()
        if regex.MOVER.match(chave(re.sub(r"[.,;:!?]", " ", texto)).strip()):
            return regex.interpretar(texto, colunas, hoje)
        # keep_alive 0: o modelo sai da VRAM logo após responder.
        corpo = json.dumps({
            "model": self.modelo, "prompt": self._prompt(texto, colunas, hoje), "format": self._schema(),
            "stream": False, "think": False, "keep_alive": 0, "options": {"temperature": 0},
        }).encode()
        req = urllib.request.Request(f"{self.url}/api/generate", corpo, {"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=180) as resp:
            r = json.loads(json.loads(resp.read())["response"])

        coluna = coluna_falada(r["coluna"], colunas) if r.get("coluna") else None
        if coluna and chave(coluna) not in chave(texto):  # o LLM escolhe coluna sem a frase pedir
            coluna = None
        acao = Adicionar(limpar_nome(r.get("nome") or ""), coluna=coluna)
        descricao = (r.get("descricao") or "").strip()
        # O LLM às vezes devolve a frase inteira como descrição: isso não acrescenta nada ao card.
        if descricao and difflib.SequenceMatcher(None, chave(descricao), chave(texto)).ratio() < 0.8:
            acao.description = descricao
        # A palavra dita depois de "prioridade" vale mais que a escolha do LLM ("urgente" virava alta).
        falada = re.search(r"\bprioridade\s+(\w+)", chave(texto))
        acao.priority = (falada and prioridade_falada(falada.group(1))) or (
            prioridade_falada(r["prioridade"]) if r.get("prioridade") else None)
        for campo_llm, campo in (("inicio", "dtstart"), ("fim", "due")):
            if r.get(campo_llm):
                expressao = re.sub(r"^(?:ate|até|a partir de|desde|pra|para|entrega|vence|prazo|comeco|começo|inicio|início)\s+",
                                   "", r[campo_llm].strip(), flags=re.I)
                setattr(acao, campo, data_falada(expressao, hoje) or data_falada(r[campo_llm], hoje))
                if getattr(acao, campo) is None:
                    acao.avisos.append(f"{campo_llm} não entendido: '{r[campo_llm]}'")
        if acao.dtstart and not acao.due and not re.search(r"\b(?:a partir|comec|inici|desde)", chave(texto)):
            acao.dtstart, acao.due = None, acao.dtstart  # data sem palavra de começo é prazo
        por_chave = {chave(e): e for e in self.etiquetas}
        acao.categories = list(dict.fromkeys(por_chave[chave(e)] for e in r.get("etiquetas") or [] if chave(e) in por_chave))
        acao.checklist = [i.strip() for i in r.get("checklist") or [] if i.strip()]
        acao.size = r.get("tamanho") if r.get("tamanho") in TAMANHOS else None
        return acao


# ---------------------------------------------------------------- destino

class ErroDestino(Exception):
    pass


def chamar_destino(destino: list[str], subcomando: str, entrada: dict | None = None):
    proc = subprocess.run([*destino, subcomando], capture_output=True, text=True,
                          input=json.dumps(entrada, ensure_ascii=False) if entrada is not None else None)
    if proc.returncode != 0:
        raise ErroDestino(proc.stderr.strip() or f"destino saiu com código {proc.returncode}")
    return json.loads(proc.stdout)


def etiquetas_do_destino(destino: list[str]) -> list[str]:
    """O subcomando etiquetas é opcional no protocolo: destino sem ele fica sem etiquetas."""
    try:
        return chamar_destino(destino, "etiquetas")
    except (ErroDestino, json.JSONDecodeError):
        return []


# ---------------------------------------------------------------- main

def notificar(titulo: str, corpo: str = "") -> None:
    subprocess.run(["notify-send", "-a", "Quadro", "-t", "7000", titulo, corpo], check=False)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--texto", help="frase a interpretar (padrão: stdin)")
    ap.add_argument("--parser", choices=["dateparser", "llm"], default=os.environ.get("TESLA_PARSER", "dateparser"))
    ap.add_argument("--dry-run", action="store_true", help="imprime a ação JSON sem aplicar nem notificar")
    ap.add_argument("--json", action="store_true", help="a entrada já é uma ação JSON; só repassa ao destino")
    args = ap.parse_args()

    config = ler_config()
    texto = (args.texto if args.texto is not None else sys.stdin.read()).strip()
    if not texto:
        notificar("Quadro: não ouvi nada")
        return 1

    try:
        if args.json:
            acao_json, avisos = json.loads(texto), []
        else:
            colunas = chamar_destino(config.destino, "colunas")
            if args.parser == "llm":
                parser = OllamaParser(config.llm_url, config.llm_modelo, etiquetas_do_destino(config.destino))
            else:
                parser = DateparserParser()
            acao = parser.interpretar(texto, colunas, dt.date.today())
            if isinstance(acao, Mover) and not acao.coluna:
                raise ValueError("; ".join(acao.avisos))
            if isinstance(acao, Adicionar) and not acao.summary:
                raise ValueError("nome da tarefa vazio")
            acao_json, avisos = acao.json(), acao.avisos

        if args.dry_run:
            print(json.dumps(acao_json, ensure_ascii=False))
            for a in avisos:
                print(f"aviso: {a}", file=sys.stderr)
            return 0

        resposta = chamar_destino(config.destino, "aplicar", acao_json)
    except Exception as e:  # erro vira notificação: o atalho não tem terminal
        if not args.dry_run:
            notificar("Quadro: nada mudou", f"{e}\nOuvi: “{texto}”")
        print(f"erro: {e}", file=sys.stderr)
        return 1

    resumo = resposta.get("resumo", resposta.get("uid", "ok"))
    resumo += "\n⚠ " + "; ".join(avisos) if avisos else ""
    print(resumo)
    notificar("Card movido" if acao_json["acao"] == "mover" else "Tarefa adicionada", resumo)
    return 0


if __name__ == "__main__":
    sys.exit(main())
